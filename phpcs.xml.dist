<?xml version="1.0"?>
<ruleset name="Feedback Collector">
	<description>WordPress Coding Standards, with PSR-4 class file names.</description>
	<file>feedback-collector.php</file>
	<file>uninstall.php</file>
	<file>includes</file>
	<arg name="extensions" value="php"/>
	<arg value="s"/>
	<config name="minimum_wp_version" value="6.5"/>
	<config name="testVersion" value="8.1-"/>
	<rule ref="WordPress">
		<!-- Classes are autoloaded PSR-4 style (includes/Admin/ItemsTable.php). -->
		<exclude name="WordPress.Files.FileName"/>
		<!-- Short ternaries are used deliberately for fallbacks. -->
		<exclude name="Universal.Operators.DisallowShortTernary"/>
		<!-- Its auto-fix rewrites the string 'wordpress' to 'WordPress', which breaks identifiers like the assignee source value. -->
		<exclude name="WordPress.WP.CapitalPDangit"/>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array"><element value="feedback-collector"/></property>
		</properties>
	</rule>
</ruleset>
